--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -24,6 +24,7 @@
 #include <IOKit/IOMemoryDescriptor.h>
 #include <libkern/c++/OSString.h>
 #include <sys/proc.h>
+#include <pexpert/pexpert.h>
 
 /* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
 enum {
@@ -65,6 +66,10 @@
 
 OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
 
+/* QEMU opt-in: skip high-frequency AppleKeyStore debug lines only.
+ * The AKS selector behavior and all return values remain unchanged. */
+static bool sweet_aks_quiet_logs;
+
 bool
 AppleKeyStore::start(IOService *provider)
 {
@@ -72,6 +77,10 @@
 		return false;
 	}
 	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	uint32_t quiet = 0;
+	if (PE_parse_boot_argn("sweet_aks_quiet", &quiet, sizeof(quiet))) {
+		sweet_aks_quiet_logs = quiet != 0;
+	}
 	registerService();
 	IOLog("SWEET AKS: AppleKeyStore registered (no passcode, unlocked)\n");
 	return true;
@@ -218,10 +227,12 @@
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	if (!sweet_aks_quiet_logs) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
