@@ -206,6 +206,23 @@
 }
 static void vn_detach(ifnet_t ifp __unused) { }
 
+/* Configd may temporarily remove this unrecognized QEMU interface's
+ * gateway while enumerating physical IONetworkInterface services. */
+static int
+vn_install_default_route(void)
+{
+    struct sockaddr_in dst, gw, mask;
+    bzero(&dst, sizeof(dst));
+    bzero(&gw, sizeof(gw));
+    bzero(&mask, sizeof(mask));
+    dst.sin_len = gw.sin_len = mask.sin_len = sizeof(dst);
+    dst.sin_family = gw.sin_family = mask.sin_family = AF_INET;
+    gw.sin_addr.s_addr = htonl(0x0a000202);
+    return rtrequest(RTM_ADD, (struct sockaddr *)&dst,
+        (struct sockaddr *)&gw, (struct sockaddr *)&mask,
+        RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+}
+
 static void
