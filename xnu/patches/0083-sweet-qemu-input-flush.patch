+static int
+vblk_flush(void)
+{
+	struct virtq_desc *desc = (struct virtq_desc *)(vb.dma + DMA_DESC);
+	struct virtq_avail *avail = (struct virtq_avail *)(vb.dma + DMA_AVAIL);
+	struct virtq_used *used = (struct virtq_used *)(vb.dma + DMA_USED);
+	struct virtio_blk_req *req = (struct virtio_blk_req *)(vb.dma + DMA_REQUEST);
+	volatile uint8_t *status = (volatile uint8_t *)(vb.dma + DMA_RESULT);
+	uint16_t prev_idx = vb.last_used;
+
+	req->type = 4; /* VIRTIO_BLK_T_FLUSH */
+	req->reserved = 0;
+	req->sector = 0;
+	*status = 0xff;
+	desc[0].addr = vb.dma_pa + DMA_REQUEST;
+	desc[0].len = sizeof(*req);
+	desc[0].flags = VRING_NEXT;
+	desc[0].next = 1;
+	desc[1].addr = vb.dma_pa + DMA_RESULT;
+	desc[1].len = 1;
+	desc[1].flags = VRING_WRITE;
+	desc[1].next = 0;
+	vblk_sync(DMA_DESC, 2 * sizeof(*desc));
+	vblk_sync(DMA_REQUEST, sizeof(*req));
+	vblk_sync(DMA_RESULT, 1);
+	avail->ring[avail->idx % QUEUE_SIZE] = 0;
+	vblk_sync(DMA_AVAIL, sizeof(*avail));
+	__builtin_arm_dsb(0xf);
+	avail->idx++;
+	vblk_sync(DMA_AVAIL, sizeof(*avail));
+	__builtin_arm_dsb(0xf);
+	vblk_wr(VREG_QUEUE_NOTIFY, 0);
+	uint64_t timeout, deadline;
+	nanoseconds_to_absolutetime(IO_TIMEOUT_NS, &timeout);
+	deadline = mach_absolute_time() + timeout;
+	for (;;) {
+		vblk_sync(DMA_USED, sizeof(*used));
+		if (used->idx != prev_idx) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET VIRTIO: FLUSH timed out\n");
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	vb.last_used = used->idx;
+	vblk_wr(VREG_IRQ_ACK, vblk_rd(VREG_IRQ_STATUS));
+	vblk_sync(DMA_RESULT, 1);
+	if (*status != 0) {
+		printf("SWEET VIRTIO: FLUSH status %u\n", *status);
+		return EIO;
+	}
+	return 0;
+}
