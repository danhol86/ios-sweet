diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -70,11 +70,17 @@
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	/* Defaults preserve Redmi timings; QEMU needs quicker feedback. */
+	uint32_t delay_secs = 90, interval_secs = 120;
+	PE_parse_boot_argn("sweetsample_delay", &delay_secs, sizeof(delay_secs));
+	PE_parse_boot_argn("sweetsample_interval", &interval_secs, sizeof(interval_secs));
+	if (delay_secs < 1 || delay_secs > 300) delay_secs = 90;
+	if (interval_secs < 1 || interval_secs > 300) interval_secs = 120;
+	(void)tsleep(&chan, PZERO, "sweetsmp", delay_secs * hz);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", interval_secs * hz);
 	}
 }
 
