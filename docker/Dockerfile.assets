# One-time, disposable *build* environment for a user's own Apple firmware.
# Only the open-source installer tools live in this image. No Apple userland
# or private disk is ever uploaded to a Docker registry or Git repository.
FROM ubuntu:24.04 AS apfs-build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git cmake g++ make libfuse3-dev libbz2-dev \
    zlib1g-dev libattr1-dev && rm -rf /var/lib/apt/lists/*
RUN git clone -q https://github.com/sgan81/apfs-fuse.git /src/apfs-fuse \
 && cd /src/apfs-fuse \
 && git checkout -q 66b86bd525e8cb90f9012543be89b1f092b75cf3 \
 && git submodule update --init --recursive \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build --parallel 2 \
 && cmake -S 3rdparty/lzfse -B /src/lzfse-build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /src/lzfse-build --parallel 2

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl python3 rsync sudo file psmisc \
    hfsprogs fuse3 libfuse3-3 libguestfs-tools linux-image-generic \
 && rm -rf /var/lib/apt/lists/*
COPY --from=apfs-build /src/apfs-fuse/build/apfs-fuse /usr/local/bin/apfs-fuse
COPY --from=apfs-build /src/apfs-fuse/LICENSE /usr/local/share/licenses/apfs-fuse-LICENSE
COPY --from=apfs-build /src/lzfse-build/lzfse /usr/local/bin/lzfse
COPY --from=apfs-build /src/lzfse-build/liblzfse.so /usr/local/lib/liblzfse.so
COPY tools/remotezip.py tools/adt.py tools/sweet-root-tweaks.py tools/mkiosroot.sh \
     tools/AutoPrepare-IosSweet.py tools/extract-im4p-adt.py \
     tools/Patch-IosSweet-MGCompat.py \
     tools/test-ios-system-containers.py /usr/local/share/iossweet-tools/
COPY docker/prepare-assets.sh /usr/local/bin/iossweet-prepare-assets
RUN chmod 0755 /usr/local/bin/iossweet-prepare-assets \
    /usr/local/share/iossweet-tools/mkiosroot.sh \
 && sed -i 's/\r$//' /usr/local/share/iossweet-tools/mkiosroot.sh \
 && ldconfig
ENV LIBGUESTFS_BACKEND=direct LIBGUESTFS_MEMSIZE=512
ENTRYPOINT ["/usr/local/bin/iossweet-prepare-assets"]
