# For Linux/advanced manual Docker Compose use ONLY. On Windows run Install-iOS-Sweet.cmd
# instead: it asks for missing files, stores paths locally, and configures Docker.
IOS_SWEET_KERNEL=/home/user/private/kernel.development.sweet
IOS_SWEET_DISK=/home/user/private/ios16.raw
IOS_SWEET_ADT=/home/user/private/d22ap.adt
IOS_SWEET_STATE_DIR=/home/user/private/docker-state
IOS_SWEET_VIEWER_PORT=8108
IOS_SWEET_CPUS=1
IOS_SWEET_SECONDS=7200
# Requires network-enabled QEMU XNU and an iOS disk seeded on first install.
IOS_SWEET_NETWORK=1
