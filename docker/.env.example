# Copy to docker/.env; paths must be absolute. User must supply firmware and a verified SWEET kernel.
IOS_SWEET_KERNEL=D:/Projects/ios-sweet/xnu/out-qemu-0086/kernel.development.sweet
IOS_SWEET_DISK=D:/Private/iOS/ios16-mgcall-test.raw
IOS_SWEET_STATE_DIR=D:/Private/iOS/sweet-docker-state
IOS_SWEET_VIEWER_PORT=8108
IOS_SWEET_CPUS=4
IOS_SWEET_SECONDS=7200
# 1 requires an experimental network-enabled kernel; networking not verified on iOS.
IOS_SWEET_NETWORK=0
